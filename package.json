{
  "name": "emberfall-card-game",
  "version": "0.8.0",
  "private": true,
  "description": "Emberfall Wind Borne: illustrated anime village, matte journal UI, responsive single-player card battle",
  "license": "MIT",
  "scripts": {
    "build": "python3 build.py",
    "test": "node --test tests/engine.test.cjs tests/anime_assets.test.cjs",
    "serve": "python3 -m http.server 8000",
    "test:browser": "python3 tests/browser_pocket.py",
    "test:touch-extra": "python3 tests/pocket_additional.py",
    "test:anime": "node --test tests/anime_assets.test.cjs && python3 tests/browser_anime.py",
    "art:anime": "python3 tools/build_anime_assets.py && python3 tools/prepare_anime_runtime.py",
    "test:additional": "python3 tests/pocket_additional.py",
    "test:world": "python3 tests/browser_windborne.py",
    "test:release": "python3 tests/run_release_checks.py",
    "art:world": "python3 tools/build_world_assets.py",
    "dev": "python3 build.py && python3 -m http.server 8000 --bind 127.0.0.1 --directory dist",
    "test:e2e": "playwright test",
    "format": "prettier --write src/presentation src/platform src/ui.js src/mobile-view.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "prettier": "^3.6.2"
  }
}

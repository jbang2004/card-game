{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "emberfall",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8000
    },
    {
      "name": "emberfall-8012",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-c",
        "import http.server as h;h.ThreadingHTTPServer.request_queue_size=512;h.ThreadingHTTPServer(('127.0.0.1',8012),h.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "port": 8012
    },
    {
      "name": "move-review",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/move-review/serve.py",
        "--port",
        "8013"
      ],
      "port": 8013
    }
  ]
}
